DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
# Add vendor-web here (the Compose service name) if running via docker-compose.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,vendor-web
DJANGO_TIME_ZONE=UTC
DJANGO_SECURE_COOKIES=False

DB_ENGINE=sqlite3
DB_NAME=sentinel_vendor
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Vendor's Ed25519 private signing key — NEVER commit this, never put it in a
# customer-facing deployment. This is the development key that pairs with the
# public key already hardcoded into this project's licenses/crypto.py *and*
# into the Data Sentinel app's licensing/crypto.py, so licenses issued here
# activate there out of the box. Rotate it before real production use with
# `python manage.py generate_signing_key` (see README — rotating requires
# updating the hardcoded public key in both projects).
LICENSE_SIGNING_PRIVATE_KEY_B64=H7wVsMcooVnAnk//Jgr3B2BJc+rThzj4XIaG8P6OTNA=

INSTALLATION_OFFLINE_AFTER_MINUTES=180
CHECK_IN_INTERVAL_SECONDS=3600
RATE_LIMIT_CHECKIN_PER_MINUTE=30

# Where the Customer Portal is running, and the shared secret this Vendor
# Portal uses to provision/update customer accounts there. Must match
# VENDOR_PROVISIONING_KEY in the Customer Portal's own .env. Never exposed
# to any customer - server-to-server only.
#
# Running both with `python manage.py runserver` directly on the same machine:
CUSTOMER_PORTAL_URL=http://localhost:8000
#
# Running both via `docker compose up` (see README, "Running both together
# with Docker"): containers can't reach each other via localhost - use the
# other project's container name and its INTERNAL port (always 8000, not
# whatever host port you mapped it to):
# CUSTOMER_PORTAL_URL=http://sentinel_customer_web:8000
VENDOR_PROVISIONING_KEY=dev-shared-provisioning-key-change-me
