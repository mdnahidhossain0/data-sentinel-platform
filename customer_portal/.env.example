DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
# Add customer-web here (the Compose service name) if running via docker-compose.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,customer-web
DJANGO_TIME_ZONE=UTC
DJANGO_SECURE_COOKIES=False

DB_ENGINE=sqlite3
DB_NAME=sentinel_customer_portal
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# The Vendor Portal's Sentinel Cloud API. This project never talks to the
# Vendor Portal's database directly - only this HTTP API.
#
# Running both with `python manage.py runserver` directly on the same machine:
SENTINEL_CLOUD_URL=http://localhost:8001
#
# Running both via `docker compose up` (see README, "Running both together
# with Docker"): containers can't reach each other via localhost - use the
# other project's container name and its INTERNAL port (always 8000, not
# whatever host port you mapped it to):
# SENTINEL_CLOUD_URL=http://vendor-web:8000
SENTINEL_CLOUD_TIMEOUT_SECONDS=5
SENTINEL_CLOUD_MAX_RETRIES=2

# Shared secret the Vendor Portal uses to provision customer logins here via
# POST /internal/provision/. Must equal VENDOR_PROVISIONING_KEY in the Vendor
# Portal's .env. Server-to-server only - never shown to any customer.
VENDOR_PROVISIONING_KEY=dev-shared-provisioning-key-change-me

LICENSE_EXPIRING_SOON_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@sentinel.example.com

# Business Insights - plain Python statistics, no LLM. Defaults to a bundled
# SQLite file (zero setup for the demo: Insights -> Load Demo Data -> Run
# Report). Point at a real Postgres server for production:
INSIGHTS_DB_ENGINE=sqlite3
INSIGHTS_DB_PATH=insights_demo.sqlite3
INSIGHTS_DB_HOST=localhost
INSIGHTS_DB_PORT=5432
INSIGHTS_DB_NAME=insights_demo
INSIGHTS_DB_USER=postgres
INSIGHTS_DB_PASSWORD=
INSIGHTS_WINDOW_DAYS=90

# Data Sentinel AI MFS platform
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_CLIENT_ID=data-sentinel-customer
KAFKA_CONSUMER_GROUP=data-sentinel-risk-v1
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Required for database connector credentials. Generate with Fernet.generate_key().
DATA_SOURCE_ENCRYPTION_KEY=
MODEL_ARTIFACT_DIR=model_artifacts
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=30
MFS_HIGH_RISK_THRESHOLD=70
MFS_MEDIUM_RISK_THRESHOLD=40
MFS_RETENTION_DAYS=365
MFS_API_RATE_LIMIT_PER_MINUTE=600
# Use redis://redis:6379/1 in Docker; blank falls back to Django local memory.
REDIS_URL=
